<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Port of the WPF Spacing.xaml; TokenParityTests compares the shared keys. -->

    <x:Double x:Key="Spacing.XS">4</x:Double>
    <x:Double x:Key="Spacing.SM">8</x:Double>
    <x:Double x:Key="Spacing.MD">12</x:Double>
    <x:Double x:Key="Spacing.LG">16</x:Double>
    <x:Double x:Key="Spacing.XL">24</x:Double>
    <x:Double x:Key="Spacing.XXL">32</x:Double>

    <Thickness x:Key="Inset.XS">4</Thickness>
    <Thickness x:Key="Inset.SM">8</Thickness>
    <Thickness x:Key="Inset.MD">12</Thickness>
    <Thickness x:Key="Inset.LG">16</Thickness>
    <Thickness x:Key="Inset.XL">24</Thickness>
    <Thickness x:Key="Inset.Page">32,24</Thickness>
    <Thickness x:Key="Inset.TopBarGroup">16,0</Thickness>
    <Thickness x:Key="Gap.Top.XS">0,4,0,0</Thickness>
    <Thickness x:Key="Gap.Top.SM">0,8,0,0</Thickness>
    <Thickness x:Key="Gap.Top.MD">0,12,0,0</Thickness>
    <Thickness x:Key="Gap.Top.LG">0,16,0,0</Thickness>
    <Thickness x:Key="Gap.Top.XL">0,24,0,0</Thickness>
    <Thickness x:Key="Gap.Left.SM">8,0,0,0</Thickness>
    <Thickness x:Key="Gap.Left.MD">12,0,0,0</Thickness>
    <Thickness x:Key="Gap.Left.LG">16,0,0,0</Thickness>
    <Thickness x:Key="Gap.Right.SM">0,0,8,0</Thickness>
    <Thickness x:Key="Gap.Bottom.SM">0,0,0,8</Thickness>

    <Thickness x:Key="Border.Bottom">0,0,0,1</Thickness>

    <!-- Trainer only -->
    <Thickness x:Key="Inset.Button">16,0</Thickness>
    <Thickness x:Key="Inset.Pill">8,2</Thickness>
    <Thickness x:Key="Inset.Row">12,8</Thickness>
    <Thickness x:Key="Inset.ViewSelector">12,0</Thickness>
    <Thickness x:Key="Border.ViewSelector">0,0,0,2</Thickness>
    <Thickness x:Key="Border.Thin">1</Thickness>
    <Thickness x:Key="Border.Right">0,0,1,0</Thickness>

    <CornerRadius x:Key="Radius.SM">4</CornerRadius>
    <CornerRadius x:Key="Radius.MD">8</CornerRadius>
    <CornerRadius x:Key="Radius.LG">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

</ResourceDictionary>
