<UserControl x:Class="NTech.DataStudio.Desktop.Views.Prepare.PrepareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NTech.DataStudio.Desktop.ViewModels.Prepare"
             xmlns:view="clr-namespace:NTech.DataStudio.Desktop.Views.Prepare">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ImportStepViewModel}"><view:ImportStepView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditStepViewModel}"><view:AuditStepView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanStepViewModel}"><view:CleanStepView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NormalizeStepViewModel}"><view:NormalizeStepView /></DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Empty state: no project open -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" Text="Prepare" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top.SM}"
                       AutomationProperties.AutomationId="PrepareNoProject"
                       Text="Hãy tạo hoặc mở một project trước." />
        </StackPanel>

        <DockPanel Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="{StaticResource Border.Bottom}">
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ViewSelector.Item}" GroupName="prepareSteps"
                                         Height="{StaticResource ControlHeight.Large}"
                                         AutomationProperties.Name="{Binding Label}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Progress and messages shared by every step -->
            <StackPanel DockPanel.Dock="Bottom" DataContext="{Binding CurrentStep}"
                        Margin="{StaticResource Inset.Page}">
                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Hủy"
                                Margin="{StaticResource Gap.Left.MD}"
                                Command="{Binding CancelCommand}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="PrepareProgressText"
                                   Text="{Binding ProgressText}" />
                    </DockPanel>
                    <ProgressBar Margin="{StaticResource Gap.Top.SM}" Maximum="100" Value="{Binding ProgressPercent}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Status.Error}"
                           AutomationProperties.AutomationId="PrepareError"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                           Text="{Binding ErrorMessage}" />
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Status.Success}"
                           AutomationProperties.AutomationId="PrepareResult"
                           Visibility="{Binding ResultMessage, Converter={StaticResource NullToCollapsed}}"
                           Text="{Binding ResultMessage}" />
            </StackPanel>

            <ContentControl Focusable="False" Content="{Binding CurrentStep}" />
        </DockPanel>
    </Grid>
</UserControl>
