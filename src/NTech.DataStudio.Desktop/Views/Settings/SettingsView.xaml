<UserControl x:Class="NTech.DataStudio.Desktop.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Inset.Page}" HorizontalAlignment="Left"
                    Width="{StaticResource Layout.PageContentMaxWidth}">

            <!-- PageHeader -->
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Cài đặt" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top.XS}"
                       Text="Cài đặt của riêng bạn trên máy này; không nằm trong project và không đi theo project khi chép sang máy khác." />

            <!-- Error state: the settings file could not be read or written -->
            <TextBlock Margin="{StaticResource Gap.Top.LG}" TextWrapping="Wrap" Style="{StaticResource Text.Body}"
                       Foreground="{StaticResource Brush.Status.Warning}"
                       AutomationProperties.AutomationId="SettingsProblem"
                       Visibility="{Binding ProblemMessage, Converter={StaticResource NullToCollapsed}}"
                       Text="{Binding ProblemMessage}" />

            <!-- Magic polygon model -->
            <Border Style="{StaticResource Surface.Card}" Margin="{StaticResource Gap.Top.LG}"
                    Padding="{StaticResource Inset.XL}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionHeader}" Text="Model Magic polygon (SAM)" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top.XS}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="ModelStatus"
                               Text="{Binding ModelStatusText}" />
                    <TextBlock Style="{StaticResource Text.MetricSmall}" Margin="{StaticResource Gap.Top.XS}" TextWrapping="Wrap"
                               ToolTip="{Binding ModelFolder}" Text="{Binding ModelFolder}" />
                    <TextBlock Margin="{StaticResource Gap.Top.MD}" TextWrapping="Wrap" Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Status.Error}"
                               AutomationProperties.AutomationId="ModelError"
                               Visibility="{Binding ModelError, Converter={StaticResource NullToCollapsed}}"
                               Text="{Binding ModelError}" />
                    <ProgressBar Margin="{StaticResource Gap.Top.MD}" Maximum="100" Value="{Binding ModelProgressPercent, Mode=OneWay}"
                                 Visibility="{Binding IsDownloadingModel, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top.MD}">
                        <Button Style="{StaticResource Button.Primary}" Content="Tải model (44,7 MB)"
                                AutomationProperties.Name="Tải model SAM"
                                Visibility="{Binding ModelMissing, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DownloadModelCommand}" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Hủy"
                                AutomationProperties.Name="Hủy tải model"
                                Visibility="{Binding IsDownloadingModel, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding CancelModelDownloadCommand}" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Mở thư mục model"
                                Margin="{StaticResource Gap.Left.SM}"
                                AutomationProperties.Name="Mở thư mục model"
                                Command="{Binding OpenModelFolderCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top.SM}" TextWrapping="Wrap"
                               Text="Tải từ huggingface.co/Acly/MobileSAM (MobileSAM, giấy phép MIT/Apache-2.0), kiểm SHA-256 sau khi tải. Máy không có mạng: chép hai file mobile_sam_image_encoder.onnx và sam_mask_decoder_single.onnx vào thư mục trên." />
                </StackPanel>
            </Border>

            <!-- Hot-Key section -->
            <Border Style="{StaticResource Surface.Card}" Margin="{StaticResource Gap.Top.LG}"
                    Padding="{StaticResource Inset.XL}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Đặt lại tất cả"
                                AutomationProperties.Name="Đặt lại tất cả phím tắt"
                                Command="{Binding ResetAllCommand}" />
                        <TextBlock Style="{StaticResource Text.SectionHeader}" VerticalAlignment="Center" Text="Phím tắt (Hot-Key)" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top.XS}" TextWrapping="Wrap"
                               Text="Bấm Đổi phím rồi nhấn phím hoặc tổ hợp Ctrl/Shift mới; Esc để hủy. Thay đổi được lưu ngay và dùng được ngay ở Annotate. Mỗi phím chỉ làm một việc; phím đang dùng cho việc khác sẽ bị từ chối. Phím số 1 đến 9 (chọn class) cố định. Space gán được, nhưng chạy khi nhả phím và chỉ khi bạn không kéo pan (giữ Space + kéo chuột) trong lúc giữ." />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top.XS}" TextWrapping="Wrap"
                               Text="Bộ gõ tiếng Việt Telex có thể làm hỏng phím chữ lặp lại (a, e, o, d, w, s, f, r, x, j, z); nếu hay gõ tiếng Việt, hãy dùng Ctrl hoặc phím khác cho việc cần nhấn liên tiếp." />

                    <!-- Feedback for the last change -->
                    <TextBlock Margin="{StaticResource Gap.Top.MD}" TextWrapping="Wrap" Style="{StaticResource Text.Secondary}"
                               AutomationProperties.AutomationId="SettingsStatus" MinHeight="20"
                               Text="{Binding StatusMessage}" />

                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="{StaticResource Gap.Top.LG}">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Title}" />
                                    <ItemsControl ItemsSource="{Binding Rows}" Margin="{StaticResource Gap.Top.XS}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="0,0,0,1"
                                                        Padding="{StaticResource Inset.SM}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="200" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Label}" />
                                                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                                       Foreground="{StaticResource Brush.Status.Error}"
                                                                       AutomationProperties.AutomationId="SettingsError"
                                                                       Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}"
                                                                       Text="{Binding ErrorText}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                Background="{StaticResource Brush.Background.Selected}"
                                                                CornerRadius="{StaticResource Radius.SM}" Padding="{StaticResource Inset.SM}">
                                                            <TextBlock Style="{StaticResource Text.MetricSmall}" Text="{Binding KeysText}" />
                                                        </Border>
                                                        <Button Grid.Column="2" Style="{StaticResource Button.Secondary}"
                                                                Content="{Binding ChangeButtonText}"
                                                                AutomationProperties.Name="{Binding ChangeAutomationName}"
                                                                Command="{Binding ChangeCommand}" />
                                                        <Button Grid.Column="3" Style="{StaticResource Button.Secondary}" Margin="{StaticResource Gap.Left.SM}"
                                                                Content="Mặc định"
                                                                AutomationProperties.Name="{Binding ResetAutomationName}"
                                                                Command="{Binding ResetCommand}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
