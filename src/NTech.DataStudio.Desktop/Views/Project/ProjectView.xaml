<UserControl x:Class="NTech.DataStudio.Desktop.Views.Project.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Inset.Page}" HorizontalAlignment="Left"
                    Width="{StaticResource Layout.PageContentMaxWidth}">

            <!-- PageHeader -->
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Project" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top.XS}"
                       Text="Mỗi project là một thư mục tự chứa: chép sang máy khác là mở được ngay." />

            <!-- Error state -->
            <TextBlock Margin="{StaticResource Gap.Top.LG}" TextWrapping="Wrap"
                       Style="{StaticResource Text.Body}"
                       Foreground="{StaticResource Brush.Status.Error}"
                       AutomationProperties.AutomationId="ProjectError"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                       Text="{Binding ErrorMessage}" />

            <!-- Loading state -->
            <TextBlock Margin="{StaticResource Gap.Top.LG}" Style="{StaticResource Text.Secondary}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                       Text="Đang xử lý..." />

            <!-- Open project -->
            <Border Style="{StaticResource Surface.Card}" Margin="{StaticResource Gap.Top.LG}"
                    Padding="{StaticResource Inset.XL}"
                    Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionHeader}"
                               AutomationProperties.AutomationId="CurrentProjectName"
                               Text="{Binding Current.Name}" />
                    <TextBlock Style="{StaticResource Text.MetricSmall}" Margin="{StaticResource Gap.Top.XS}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Current.RootPath}"
                               Text="{Binding Current.RootPath}" />

                    <TextBlock Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.LG}" Text="Task mục tiêu" />
                    <ComboBox Margin="{StaticResource Gap.Top.XS}" HorizontalAlignment="Left"
                              Width="{StaticResource Layout.FormFieldWidth}"
                              AutomationProperties.Name="Task mục tiêu của project"
                              ItemsSource="{Binding TaskOptions}" DisplayMemberPath="Label"
                              SelectedItem="{Binding CurrentTask}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top.XS}" TextWrapping="Wrap"
                               Text="Quyết định công cụ vẽ ở Annotate. Đổi task không xóa hay sửa nhãn đã có." />

                    <Grid Margin="{StaticResource Gap.Top.LG}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Current.ImageCount}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Ảnh" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Current.AnnotatedImageCount}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Ảnh đã gán" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Current.ClassCount}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Class" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Current.VersionCount}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Version" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top.XL}">
                        <Button Style="{StaticResource Button.Secondary}" Content="Đóng project"
                                Command="{Binding CloseCommand}" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Mở project khác"
                                Margin="{StaticResource Gap.Left.SM}"
                                Command="{Binding OpenCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Empty state: no project open -->
            <StackPanel Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}">
                <Border Style="{StaticResource Surface.Card}" Margin="{StaticResource Gap.Top.LG}"
                        Padding="{StaticResource Inset.XL}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionHeader}" Text="Tạo project mới" />

                        <TextBlock Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.LG}" Text="Tên project" />
                        <TextBox Style="{StaticResource Input.Text}" Margin="{StaticResource Gap.Top.XS}"
                                 HorizontalAlignment="Left" Width="{StaticResource Layout.FormFieldWidth}"
                                 AutomationProperties.Name="Tên project"
                                 Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.MD}" Text="Thư mục đặt project" />
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top.XS}">
                            <TextBox Style="{StaticResource Input.Text}" Width="{StaticResource Layout.FormFieldWidth}"
                                     AutomationProperties.Name="Thư mục đặt project"
                                     Text="{Binding ParentFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Style="{StaticResource Button.Secondary}" Content="Chọn..."
                                    Margin="{StaticResource Gap.Left.SM}"
                                    Command="{Binding BrowseParentFolderCommand}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.MD}" Text="Task mục tiêu" />
                        <ComboBox Margin="{StaticResource Gap.Top.XS}" HorizontalAlignment="Left"
                                  Width="{StaticResource Layout.FormFieldWidth}"
                                  AutomationProperties.Name="Task mục tiêu"
                                  ItemsSource="{Binding TaskOptions}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding NewTask}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top.XS}" TextWrapping="Wrap"
                                   Text="Segment (polygon) xuất được cả Segment lẫn Detect; chọn Detect nếu chỉ cần box và muốn vẽ nhanh. Đổi được sau." />

                        <Button Style="{StaticResource Button.Primary}" Content="Tạo project"
                                HorizontalAlignment="Left" Margin="{StaticResource Gap.Top.LG}"
                                Command="{Binding CreateCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Surface.Card}" Margin="{StaticResource Gap.Top.LG}"
                        Padding="{StaticResource Inset.XL}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionHeader}" Text="Mở project có sẵn" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top.XS}"
                                   Text="Chọn thư mục chứa project.db." />
                        <Button Style="{StaticResource Button.Secondary}" Content="Mở project"
                                HorizontalAlignment="Left" Margin="{StaticResource Gap.Top.LG}"
                                Command="{Binding OpenCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
