<UserControl x:Class="NTech.DataStudio.Desktop.Views.Project.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Inset.Page}" HorizontalAlignment="Left"
                    Width="{StaticResource Layout.PageContentMaxWidth}">

            <!-- PageHeader -->
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Project" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top.XS}"
                       Text="Mỗi project là một thư mục tự chứa: chép sang máy khác là mở được ngay." />

            <!-- Error state -->
            <TextBlock Margin="{StaticResource Gap.Top.LG}" TextWrapping="Wrap"
                       Style="{StaticResource Text.Body}"
                       Foreground="{StaticResource Brush.Status.Error}"
                       AutomationProperties.AutomationId="ProjectError"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                       Text="{Binding ErrorMessage}" />

            <!-- Loading state -->
            <TextBlock Margin="{StaticResource Gap.Top.LG}" Style="{StaticResource Text.Secondary}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                       Text="Đang xử lý..." />

            <!-- Open project -->
            <Border Style="{StaticResource Surface.Card}" Margin="{StaticResource Gap.Top.LG}"
                    Padding="{StaticResource Inset.XL}"
                    Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionHeader}"
                               AutomationProperties.AutomationId="CurrentProjectName"
                               Text="{Binding Current.Name}" />
                    <TextBlock Style="{StaticResource Text.MetricSmall}" Margin="{StaticResource Gap.Top.XS}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Current.RootPath}"
                               Text="{Binding Current.RootPath}" />

                    <TextBlock Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.LG}" Text="Task mục tiêu" />
                    <ItemsControl Margin="{StaticResource Gap.Top.XS}" ItemsSource="{Binding CurrentTasks}"
                                  AutomationProperties.AutomationId="CurrentProjectTasks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="{StaticResource Gap.Top.XS}" Content="{Binding Label}"
                                          AutomationProperties.Name="{Binding Label}"
                                          IsChecked="{Binding IsChecked}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top.XS}" TextWrapping="Wrap"
                               Text="Tích nhiều task nếu project cần cả box và polygon. Task quyết định công cụ vẽ ở Annotate; đổi task không xóa hay sửa nhãn đã có." />

                    <Grid Margin="{StaticResource Gap.Top.LG}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Current.ImageCount}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Ảnh" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Current.AnnotatedImageCount}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Ảnh đã gán" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Current.ClassCount}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Class" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Current.VersionCount}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Version" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top.XL}">
                        <Button Style="{StaticResource Button.Secondary}" Content="Đóng project"
                                Command="{Binding CloseCommand}" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Mở project khác"
                                Margin="{StaticResource Gap.Left.SM}"
                                Command="{Binding OpenCommand}" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Mở từ file .zip..."
                                Margin="{StaticResource Gap.Left.SM}"
                                AutomationProperties.AutomationId="ProjectOpenZip"
                                Command="{Binding Package.OpenFromZipCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Package the open project into a versioned .zip (decision 0020) -->
            <Border Style="{StaticResource Surface.Card}" Margin="{StaticResource Gap.Top.LG}"
                    Padding="{StaticResource Inset.XL}"
                    Visibility="{Binding HasProject, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DataContext="{Binding Package}">
                    <TextBlock Style="{StaticResource Text.SectionHeader}" Text="Đóng gói project" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top.XS}" TextWrapping="Wrap"
                               Text="Gói toàn bộ project thành một file .zip có số phiên bản (tên_v001.zip), để chép sang máy khác hoặc chia sẻ. Mở lại bằng Mở từ file .zip. Đóng gói được cả khi project đang mở." />

                    <CheckBox Margin="{StaticResource Gap.Top.MD}" Content="{Binding SourceText}"
                              AutomationProperties.AutomationId="PackageIncludeSource" AutomationProperties.Name="Kèm ảnh nguồn"
                              IsEnabled="{Binding CanEdit}" IsChecked="{Binding IncludeSource}" />
                    <CheckBox Margin="{StaticResource Gap.Top.XS}" Content="{Binding ExportsText}"
                              AutomationProperties.AutomationId="PackageIncludeExports" AutomationProperties.Name="Kèm dataset đã xuất"
                              IsEnabled="{Binding CanEdit}" IsChecked="{Binding IncludeExports}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top.SM}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="PackageSize" Text="{Binding SizeText}" />

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top.MD}">
                        <Button Style="{StaticResource Button.Primary}" Content="Đóng gói..."
                                AutomationProperties.AutomationId="PackageStart" AutomationProperties.Name="Đóng gói project"
                                Command="{Binding PackCommand}" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Hủy" Margin="{StaticResource Gap.Left.SM}"
                                AutomationProperties.AutomationId="PackageCancel"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Mở thư mục chứa file" Margin="{StaticResource Gap.Left.SM}"
                                AutomationProperties.AutomationId="PackageOpenFolder"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding OpenResultFolderCommand}" />
                    </StackPanel>

                    <ProgressBar Margin="{StaticResource Gap.Top.MD}" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Margin="{StaticResource Gap.Top.SM}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="PackageProgress"
                               Visibility="{Binding ProgressText, Converter={StaticResource NullToCollapsed}}"
                               Text="{Binding ProgressText}" />
                    <TextBlock Margin="{StaticResource Gap.Top.SM}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="PackageResult"
                               Visibility="{Binding ResultMessage, Converter={StaticResource NullToCollapsed}}"
                               Text="{Binding ResultMessage}" />
                    <TextBlock Margin="{StaticResource Gap.Top.SM}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Status.Error}"
                               AutomationProperties.AutomationId="PackageError"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                               Text="{Binding ErrorMessage}" />
                </StackPanel>
            </Border>

            <!-- Empty state: no project open -->
            <StackPanel Visibility="{Binding HasProject, Converter={StaticResource InverseBoolToVisibility}}">
                <Border Style="{StaticResource Surface.Card}" Margin="{StaticResource Gap.Top.LG}"
                        Padding="{StaticResource Inset.XL}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionHeader}" Text="Tạo project mới" />

                        <TextBlock Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.LG}" Text="Tên project" />
                        <TextBox Style="{StaticResource Input.Text}" Margin="{StaticResource Gap.Top.XS}"
                                 HorizontalAlignment="Left" Width="{StaticResource Layout.FormFieldWidth}"
                                 AutomationProperties.Name="Tên project"
                                 Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.MD}" Text="Thư mục đặt project" />
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top.XS}">
                            <TextBox Style="{StaticResource Input.Text}" Width="{StaticResource Layout.FormFieldWidth}"
                                     AutomationProperties.Name="Thư mục đặt project"
                                     Text="{Binding ParentFolder, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Style="{StaticResource Button.Secondary}" Content="Chọn..."
                                    Margin="{StaticResource Gap.Left.SM}"
                                    Command="{Binding BrowseParentFolderCommand}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top.MD}" Text="Task mục tiêu" />
                        <ItemsControl Margin="{StaticResource Gap.Top.XS}" ItemsSource="{Binding NewTasks}"
                                      AutomationProperties.AutomationId="NewProjectTasks">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="{StaticResource Gap.Top.XS}" Content="{Binding Label}"
                                              AutomationProperties.Name="{Binding Label}"
                                              IsChecked="{Binding IsChecked}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top.XS}" TextWrapping="Wrap"
                                   Text="Tích một hoặc nhiều task. Segment (polygon) xuất được cả Segment lẫn Detect; chọn Detect nếu chỉ cần box và muốn vẽ nhanh. Đổi được sau." />

                        <Button Style="{StaticResource Button.Primary}" Content="Tạo project"
                                HorizontalAlignment="Left" Margin="{StaticResource Gap.Top.LG}"
                                Command="{Binding CreateCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Surface.Card}" Margin="{StaticResource Gap.Top.LG}"
                        Padding="{StaticResource Inset.XL}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionHeader}" Text="Mở project có sẵn" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top.XS}"
                                   Text="Chọn thư mục chứa project.db." />
                        <Button Style="{StaticResource Button.Secondary}" Content="Mở project"
                                HorizontalAlignment="Left" Margin="{StaticResource Gap.Top.LG}"
                                Command="{Binding OpenCommand}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Surface.Card}" Margin="{StaticResource Gap.Top.LG}"
                        Padding="{StaticResource Inset.XL}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionHeader}" Text="Mở từ gói .zip" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top.XS}" TextWrapping="Wrap"
                                   Text="Chọn file .zip do Đóng gói project tạo ra (trên máy này hoặc máy khác); app giải nén vào thư mục bạn chọn rồi mở project." />
                        <Button Style="{StaticResource Button.Secondary}" Content="Mở từ file .zip..."
                                HorizontalAlignment="Left" Margin="{StaticResource Gap.Top.LG}"
                                AutomationProperties.AutomationId="ProjectOpenZipEmpty"
                                Command="{Binding Package.OpenFromZipCommand}" />
                        <TextBlock Margin="{StaticResource Gap.Top.SM}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="PackageResultEmpty"
                                   Visibility="{Binding Package.ResultMessage, Converter={StaticResource NullToCollapsed}}"
                                   Text="{Binding Package.ResultMessage}" />
                        <TextBlock Margin="{StaticResource Gap.Top.SM}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.Status.Error}"
                                   AutomationProperties.AutomationId="PackageErrorEmpty"
                                   Visibility="{Binding Package.ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                                   Text="{Binding Package.ErrorMessage}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
