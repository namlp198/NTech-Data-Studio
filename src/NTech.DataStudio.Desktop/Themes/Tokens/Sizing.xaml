<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Control, icon and layout sizes — docs/design/DESIGN_SYSTEM.md. -->
    <sys:Double x:Key="ControlHeight.Small">28</sys:Double>
    <sys:Double x:Key="ControlHeight.Medium">36</sys:Double>
    <sys:Double x:Key="ControlHeight.Large">44</sys:Double>

    <sys:Double x:Key="IconSize.Small">14</sys:Double>
    <sys:Double x:Key="IconSize.Medium">18</sys:Double>
    <sys:Double x:Key="IconSize.Large">24</sys:Double>

    <!-- HUD shell layout -->
    <sys:Double x:Key="Layout.TopBarHeight">48</sys:Double>
    <sys:Double x:Key="Layout.ToolRailWidth">56</sys:Double>
    <sys:Double x:Key="Layout.FloatingPanelWidth">320</sys:Double>
    <sys:Double x:Key="Layout.FloatingPanelMaxHeight">640</sys:Double>

    <!-- Page screens (Project, Prepare, Dataset, Export) -->
    <sys:Double x:Key="Layout.PageContentMaxWidth">960</sys:Double>
    <sys:Double x:Key="Layout.FormFieldWidth">480</sys:Double>
    <sys:Double x:Key="Layout.PreviewHeight">420</sys:Double>
    <sys:Double x:Key="Layout.ThumbnailCellHeight">48</sys:Double>
    <DataGridLength x:Key="Layout.ThumbnailColumnWidth">88</DataGridLength>
    <DataGridLength x:Key="Layout.ActionColumnWidth">128</DataGridLength>
    <!-- Annotate -->
    <sys:Double x:Key="Layout.ThumbnailStripHeight">168</sys:Double>
    <sys:Double x:Key="Layout.FilterWidth">160</sys:Double>
    <sys:Double x:Key="Layout.DividerThickness">1</sys:Double>
    <sys:Double x:Key="Layout.ThumbnailItemWidth">104</sys:Double>
    <sys:Double x:Key="Layout.ThumbnailImageHeight">72</sys:Double>
    <sys:Double x:Key="Layout.StatusDotSize">10</sys:Double>
    <sys:Double x:Key="Layout.SwatchSize">14</sys:Double>
    <sys:Double x:Key="Layout.PaletteSwatchSize">20</sys:Double>
    <sys:Double x:Key="Layout.ClassListMaxHeight">150</sys:Double>
    <sys:Double x:Key="Layout.LabelListMaxHeight">190</sys:Double>
    <!-- Dataset -->
    <sys:Double x:Key="Layout.PercentFieldWidth">80</sys:Double>
    <sys:Double x:Key="Layout.PreviewCellHeight">190</sys:Double>
    <sys:Double x:Key="Layout.ClassTableMaxHeight">260</sys:Double>
    <GridLength x:Key="Layout.DatasetSettingsGridWidth">400</GridLength>
    <GridLength x:Key="Layout.ValueFieldGridWidth">72</GridLength>
    <GridLength x:Key="Layout.FloatingPanelGridWidth">320</GridLength>
    <GridLength x:Key="Layout.HotkeyGridWidth">20</GridLength>
    <GridLength x:Key="Layout.NumberFieldGridWidth">120</GridLength>
    <GridLength x:Key="Spacing.LG.Grid">16</GridLength>

</ResourceDictionary>

